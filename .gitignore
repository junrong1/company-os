# macOS
.DS_Store
._*

# JetBrains IDEs
.idea/
*.iml

# Editors
.vscode/
*.swp

# Node (the test/ scripts run under node; no deps checked in)
node_modules/
npm-debug.log*
yarn-error.log*

# Python (the backend runs under uv; the venv and bytecode are local artifacts)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local SQLite store. README calls this git-ignored; this is what makes that true.
backend/var/

# Environment / secrets
.env
.env.local

# Local Compound Engineering prototypes and session artifacts
.context/compound-engineering/

# Agent worktrees. `.claude/skills/` is tracked, so without this an isolated
# worktree checked out under `.claude/` reads as untracked files inside a
# tracked directory — and one `git add .claude` would commit a whole checkout.
.claude/worktrees/
